{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/andreagosto/Appunti-Firefox-Plugin",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "__MSG_browserActionTitle__"
  },
  "sidebar_action": {
    "default_title": "__MSG_sidebarTitle__",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/selection-to-md.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "append-selection": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "__MSG_commandAppendDescription__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "appunti-firefox-plugin@andreagosto.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
